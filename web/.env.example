# Supabase (create project at https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (https://dashboard.stripe.com/apikeys) — omit or use placeholders to skip payment in dev
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Set true to skip Stripe Checkout even when keys exist (testing only)
# WISELISTA_SKIP_PAYMENT=true

# Comma-separated pilot codes — skip Stripe when entered at submit (e.g. WISEPILOT,PILOT2026)
# WISELISTA_PILOT_PROMO_CODES=WISEPILOT

# Claid.ai (optional — when set, submit uses real AI enhancement; otherwise mock)
# Get key at https://claid.ai/login → Create API key
# CLAID_API_KEY=your-claid-api-key

# App (optional)
NEXT_PUBLIC_APP_URL=http://localhost:3000
